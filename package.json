{
  "dependencies": {
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@league-of-foundry-developers/foundry-vtt-types": "^12.331.3-beta",
    "copyfiles": "^2.4.1",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build:ts": "tsc",
    "build:copy": "copyfiles -u 1 \"src/templates/**/*.html\" build/",
    "build": "npm-run-all clean build:ts build:copy",
    "prepare-release": "node scripts/prepare-release.mjs",
    "package": "npm run build && npm run prepare-release"
  }
}
